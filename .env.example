# Local configuration for the warehouse fulfillment lab.
# Copy to .env (git-ignored). Values match compose.yaml; lab credentials, not secrets.
# The app does not read .env by itself. Load it with either:
#   uv run --env-file .env <command>
#   set -a; source .env; set +a

# --- Application / demo / drills ---
LAB_DATABASE_URL=postgresql+psycopg://lab:lab@127.0.0.1:55432/warehouse_lab
LAB_AMQP_URL=amqp://lab:lab@127.0.0.1:55672/
LAB_DYNAMODB_URL=http://127.0.0.1:58000
LAB_LOKI_URL=http://127.0.0.1:53100
LAB_RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:55673
LAB_LOG_LEVEL=INFO
# Setting this turns the Valkey read cache ON in the API. Leave commented to run without it.
# LAB_VALKEY_URL=valkey://127.0.0.1:56379/0

# --- Test suite gates (without a URL, that group of tests skips) ---
LAB_TEST_DATABASE_URL=postgresql+psycopg://lab:lab@127.0.0.1:55432/warehouse_lab
LAB_TEST_AMQP_URL=amqp://lab:lab@127.0.0.1:55672/
LAB_TEST_VALKEY_URL=valkey://127.0.0.1:56379/0
LAB_TEST_DYNAMODB_URL=http://127.0.0.1:58000
LAB_TEST_LOKI_URL=http://127.0.0.1:53100
LAB_TEST_DEMO=1
LAB_TEST_DRILLS=1
# Only while the real Valkey service is STOPPED (docker compose stop valkey):
# LAB_TEST_VALKEY_DOWN_URL=valkey://127.0.0.1:56379/0

# --- scripts/smoke_observability.sh (optional) ---
# LAB_SMOKE_DATABASE_URL=postgresql+psycopg://lab:lab@127.0.0.1:55432/warehouse_lab
# LAB_SMOKE_LOKI_URL=http://127.0.0.1:53100
# LAB_SMOKE_PORT=5099
