      "updated": 1792366704908,
      "link": null,
      "locked": false,
      "text": "Integration design: idempotent ingestion, async workers, retries, reconciliation, and per-client inventory ownership.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Integration design: idempotent ingestion, async workers, retries, reconciliation, and per-client inventory ownership.",
      "lineHeight": 1.23,
      "autoResize": false,
      "customData": {},
      "index": "b3e",
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
